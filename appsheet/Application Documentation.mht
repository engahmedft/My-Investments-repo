.google-material-icons { font-family: "Google Material Icons"; font-weight: 400; font-style: normal; font-size: 24px; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-block; white-space: nowrap; overflow-wrap: normal; direction: ltr; font-feature-settings: "liga"; -webkit-font-smoothing: antialiased; }

i.material { font-family: "Google Material Icons"; font-style: normal; text-transform: lowercase; font-feature-settings: "liga"; }

i.material.clickable { border-radius: 18px; cursor: pointer; font-size: 20px; padding: 8px; }

i.material.clickable:hover { background-color: rgb(232, 234, 237); }

html { text-size-adjust: 100%; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }

body { margin: 0px; line-height: 1; }

iframe { border: 0px; }

main { display: block; }

ol, ul { margin-top: 0px; margin-bottom: 0px; padding-left: 0px; }

li { display: block; }

dl { margin-top: 0px; margin-bottom: 0px; }

dd { margin-left: 0px; }

h1, h2, h3, h4, h5, h6 { margin-top: 0px; margin-bottom: 0px; font-size: inherit; }

blockquote { margin: 0px; padding: 0px; }

p { margin-top: 0px; margin-bottom: 0px; }

br { margin: 0px !important; }

sup { position: relative; top: -0.5em; vertical-align: baseline; font-size: 75%; line-height: 0; }

strong { font-weight: 700; }

figure { margin: 0px; }

img { border: 0px; max-width: 100%; height: auto; vertical-align: middle; }

a { text-decoration: none; color: inherit; }

button { border: 0px; margin: 0px; padding: 0px; text-align: inherit; text-transform: inherit; font: inherit; -webkit-font-smoothing: inherit; letter-spacing: inherit; background: 0px 0px; overflow: visible; }

*, ::after, ::before { box-sizing: border-box; }

.clearfix::after, .clearfix::before { content: " "; display: table; }

.clearfix::after { clear: both; }

:focus { outline: 0px; }

.display1, .display2, .display3 { font-family: "Google Sans Display", Arial, sans-serif; font-weight: 400; color: rgb(32, 33, 36); }

.display1 { font-size: 64px; line-height: 76px; }

.display2 { font-size: 56px; line-height: 64px; }

.display3 { font-size: 44px; line-height: 52px; }

h1, h2, h3, h4, h5, h6 { font-family: "Google Sans"; font-weight: 400; color: rgb(32, 33, 36); }

h1 { font: 36px / 44px "Google Sans", sans-serif; }

h2 { font: 32px / 40px "Google Sans", sans-serif; }

h3 { font: 28px / 36px "Google Sans", sans-serif; }

h4 { font: 24px / 32px "Google Sans", sans-serif; }

h5 { font: 22px / 28px "Google Sans", sans-serif; }

h6 { font: 18px / 24px "Google Sans", sans-serif; }

.subheader1, .subheader2 { font-family: "Google Sans"; font-weight: 500; color: rgb(32, 33, 36); }

.subheader1 { font-size: 16px; line-height: 24px; letter-spacing: 0.1px; }

.subheader2 { font-size: 14px; line-height: 20px; letter-spacing: 0.25px; }

.subtitle1, .subtitle2 { font-family: Roboto; font-weight: 500; color: rgb(32, 33, 36); }

.subtitle1 { font-size: 16px; line-height: 24px; letter-spacing: 0.1px; }

.subtitle2 { font-size: 14px; line-height: 20px; letter-spacing: 0.25px; }

.overline { font-family: Roboto; font-weight: 700; text-transform: uppercase; font-size: 11px; line-height: 16px; letter-spacing: 0.8px; }

.body1, .body2 { font-family: Roboto; font-weight: 400; }

.body1 { font-size: 16px; line-height: 24px; letter-spacing: 0.1px; }

.body2 { font-size: 14px; line-height: 20px; letter-spacing: 0.2px; }

.caption { font-family: Roboto; font-weight: 400; font-size: 12px; line-height: 16px; letter-spacing: 0.3px; }

.thinScrollbar::-webkit-scrollbar { width: 8px; height: 8px; border-radius: 100px; }

.thinScrollbar::-webkit-scrollbar-thumb { background: rgb(218, 220, 224); border-radius: 100px; }

.materialControl { font-family: Roboto; font-weight: 400; font-size: 16px; line-height: 24px; letter-spacing: 0.1px; min-height: 40px; padding: 0px 12px; background: rgb(241, 243, 244); border: 1px solid rgb(232, 234, 237); box-sizing: border-box; border-radius: 4px; }

.materialInput { font-family: Roboto; font-weight: 400; font-size: 16px; line-height: 24px; letter-spacing: 0.1px; min-height: 40px; padding: 0px 12px; background: rgb(241, 243, 244); border: 1px solid rgb(232, 234, 237); box-sizing: border-box; border-radius: 4px; }

.materialTextArea { font-family: Roboto; font-weight: 400; font-size: 16px; line-height: 24px; letter-spacing: 0.1px; min-height: 40px; background: rgb(241, 243, 244); border: 1px solid rgb(232, 234, 237); box-sizing: border-box; border-radius: 4px; padding: 8px 12px; }

.materialSelect { font-family: Roboto; font-weight: 400; font-size: 16px; line-height: 24px; letter-spacing: 0.1px; min-height: 40px; border: 1px solid rgb(232, 234, 237); box-sizing: border-box; border-radius: 4px; padding: 0px 24px 0px 12px; appearance: none; background: url("data:image/svg+xml;utf8,<svg fill='%2380868b' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/><path d='M0 0h24v24H0z' fill='none'/></svg>") right center no-repeat rgb(241, 243, 244); }

table.material-table { width: 100%; margin-bottom: 20px; border-collapse: separate; border-spacing: 0px; border: 1px solid rgb(232, 234, 237); border-radius: 4px; }

table.material-table thead tr { font-family: Roboto; font-weight: 500; font-size: 14px; line-height: 20px; letter-spacing: 0.25px; color: rgb(95, 99, 104); }

table.material-table thead tr td, table.material-table thead tr th { padding: 16px; border-bottom: 1px solid rgb(232, 234, 237); }

table.material-table tbody tr td { padding: 16px; }

table.material-table.striped-table tbody tr td { border-bottom: 1px solid rgb(232, 234, 237); }

table.material-table.display-table tbody > tr { font-family: Roboto; font-weight: 400; font-size: 14px; line-height: 20px; letter-spacing: 0.2px; }

table.material-table.display-table tbody > tr :first-child { color: rgb(32, 33, 36); }

table.material-table.display-table tbody > tr :last-of-type td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

@keyframes progress-keyframes { 
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

.loading-wrapper { width: 100%; height: 100%; position: relative; transform: translateZ(0px) scale(1); backface-visibility: hidden; transform-origin: 0px 0px; }

.loading-wrapper div { position: absolute; width: 60%; height: 60%; border-width: 4px; border-style: solid; border-color: transparent rgb(26, 115, 232) rgb(26, 115, 232); border-image: none; border-radius: 50%; animation: 1s linear 0s infinite normal none running progress-keyframes; top: 50%; left: 50%; box-sizing: content-box; }

.animate { transition: 0.2s ease-out; }

.hidden { display: none; }

.centered { text-align: center; }

a { transition: 0.2s ease-out; }

.standard-shadow { box-shadow: rgba(0, 0, 0, 0.08) 1px 1px 5px 0px; }

.standard-shadow-inset { box-shadow: rgba(0, 0, 0, 0.1) 1px 1px 5px 0px inset; }

#cloningClickEater { display: none; }

#cloningClickEater #waitingClone { padding-top: 25vh; position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(32, 33, 36, 0.6); z-index: 1010; color: rgb(255, 255, 255); font-size: 33.1776px; text-align: center; }

#cloningClickEater #waitingClone p { color: rgb(255, 255, 255); opacity: 1; }

.loader, .loader::after, .loader::before { border-radius: 50%; width: 2.5em; height: 2.5em; animation: 1.8s ease-in-out 0s infinite normal none running load7; }

.loader { color: rgb(255, 255, 255); font-size: 10px; margin: 80px auto; position: relative; text-indent: -9999em; transform: translateZ(0px); animation-delay: -0.16s; }

.loader::before { left: -3.5em; animation-delay: -0.32s; }

.loader::after { left: 3.5em; }

.loader::after, .loader::before { content: ""; position: absolute; top: 0px; }

@keyframes load7 { 
  0%, 100%, 80% { box-shadow: 0px 2.5em 0px -1.3em; }
  40% { box-shadow: 0px 2.5em 0px 0px; }
}

.bottomNav, .topNav { background: rgb(255, 255, 255); }

.topNav { z-index: 99; position: relative; height: 64px; }

.topNav .primaryNav { font-family: "Google Sans", "Open Sans", Helvetica, Arial, sans-serif; height: 64px; margin: 0px auto; padding: 8px 12px 8px 24px; font-size: 14px; font-weight: 500; white-space: nowrap; display: flex; align-items: center; }

